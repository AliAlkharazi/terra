DATABASE_URL="postgresql://postgres:postgres@localhost:5432/terra?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Optional — used for better price estimates in Ask.
# Without a key, Ask still works from the local catalog.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Enable Banking (Sparkasse / Open Banking AIS) ──────────────────────────
# 1. Sign in at https://enablebanking.com/sign-in/
# 2. Register an application (sandbox first; Restricted Production for your own account).
# 3. Whitelist redirect URI exactly as ENABLE_BANKING_REDIRECT_URI below
#    (must be HTTPS publicly reachable — use a tunnel in dev, e.g. cloudflared).
# 4. Download the .pem private key; paste contents into ENABLE_BANKING_PRIVATE_KEY
#    (keep \n as real newlines or use \n escapes in a single line).
# 5. Set BANK_SYNC_ENCRYPTION_KEY to a 32-byte hex string:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Without these, /bank/* returns 503 except in MOCK mode (ENABLE_BANKING_MOCK=1).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_REDIRECT_URI=http://localhost:4000/bank/callback
ENABLE_BANKING_API_ORIGIN=https://api.enablebanking.com
BANK_SYNC_ENCRYPTION_KEY=
# Set to 1 to exercise connect/sync UI without real Enable Banking credentials.
ENABLE_BANKING_MOCK=0
