    "date-fns": "^3.6.0",
    "expo": "~54.0.0",
    "expo-asset": "^57.0.18",
    "expo-file-system": "^57.0.7",
    "expo-font": "~14.0.4",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~14.1.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
